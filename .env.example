APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost
APP_FORCE_HTTPS=false
TRUSTED_PROXIES=

# Market profile. This is the single source for language and direction:
# `palestine` => Arabic/RTL, `us` => English/LTR.
MARKET_PROFILE=palestine
# Optional timezone override; language and direction always follow MARKET_PROFILE.
MARKET_TIMEZONE=
APP_TIMEZONE=Asia/Hebron
RESTAURANT_CURRENCY=
RESTAURANT_CURRENCY_SYMBOL=
RESTAURANT_TAX_LABEL=
RESTAURANT_TAX_NUMBER_LABEL=
RESTAURANT_TAX_RATE=
RESTAURANT_SERVICE_LABEL=
RESTAURANT_SERVICE_RATE=
RESTAURANT_PHONE_COUNTRY=

# Local/on-prem server: the LAN address customers reach over the restaurant
# WiFi, so QR menus keep working when the internet is down. Leave empty for
# pure cloud deployments (QR then uses APP_URL). e.g. http://relax.local
MENU_BASE_URL=

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_SECURE_COOKIE=false
SESSION_SAME_SITE=lax

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

# Nightly DB backup (php artisan backup:run). BACKUP_DISK is an optional
# off-site filesystem disk (e.g. s3) to copy each dump to; leave empty to
# keep backups local-only under storage/app/backups.
BACKUP_DISK=
BACKUP_KEEP=14
# MYSQLDUMP_BINARY=mysqldump

# Cloud sync (docs/offline-sync-architecture.md). On a branch (on-prem) node
# set SYNC_ENABLED=true, SYNC_ROLE=branch and point it at the cloud. On the
# central node set SYNC_ROLE=cloud. SYNC_TOKEN is the shared secret on both
# ends. Leave SYNC_ROLE=standalone (default) for single-node installs.
SYNC_ENABLED=false
SYNC_ROLE=standalone
SYNC_CLOUD_URL=
SYNC_TOKEN=
SYNC_BRANCH_ID=
SYNC_BRANCH_UUID=

# Licensing. The cloud node manages customer licenses and cash renewals.
# Branch nodes keep a signed local cache and refresh from the cloud.
LICENSE_ENABLED=false
LICENSE_ROLE="${SYNC_ROLE}"
LICENSE_CLOUD_URL="${SYNC_CLOUD_URL}"
LICENSE_KEY=
# Run `php artisan license:generate-keys` on your private license cloud.
# Cloud node: set LICENSE_PRIVATE_KEY_PATH and LICENSE_PUBLIC_KEY_PATH.
# Customer/branch nodes: set LICENSE_PUBLIC_KEY_PATH only. Never ship the
# private key to a customer.
LICENSE_PRIVATE_KEY_PATH=
LICENSE_PUBLIC_KEY_PATH=
LICENSE_PRIVATE_KEY=
LICENSE_PUBLIC_KEY=
# Legacy/dev fallback only. Prefer the private/public key settings above.
LICENSE_SIGNING_SECRET=
LICENSE_GRACE_DAYS=14
LICENSE_WARNING_DAYS=30
LICENSE_REFRESH_HOURS=12

VITE_APP_NAME="${APP_NAME}"
VITE_REVERB_ENABLED=false
